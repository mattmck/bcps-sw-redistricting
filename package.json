{
  "name": "redistricting",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "legacy:serve": "gulp serve",
    "legacy:build": "gulp build",
    "legacy:test": "gulp test",
    "codeql:create-db": "codeql database create codeql-db --language=javascript --source-root=. --overwrite",
    "codeql:analyze": "codeql database analyze codeql-db codeql/javascript-queries:codeql-suites/javascript-security-and-quality.qls --format=sarif-latest --output=codeql-results.sarif",
    "codeql:view": "cat codeql-results.sarif | jq '.runs[0].results[] | {ruleId, message: .message.text, location: .locations[0].physicalLocation.artifactLocation.uri}'",
    "codeql:view-html": "open https://microsoft.github.io/sarif-web-component/ && echo 'Drop codeql-results.sarif into the browser window'",
    "codeql:scan": "npm run codeql:create-db && npm run codeql:analyze && echo '\n✅ Analysis complete! View results with: npm run codeql:view or npm run codeql:view-html'",
    "codeql:clean": "rm -rf codeql-db codeql-results.sarif"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "browser-sync": "^3.0.4",
    "browser-sync-spa": "^1.0.3",
    "chalk": "^4.1.2",
    "concat-stream": "^2.0.0",
    "del": "^6.1.1",
    "graceful-fs": "^4.2.11",
    "gulp": "^5.0.1",
    "gulp-angular-filesort": "^1.1.1",
    "gulp-angular-templatecache": "^3.0.1",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-connect": "^5.7.0",
    "gulp-consolidate": "^0.2.0",
    "gulp-csso": "^4.0.1",
    "gulp-filter": "^9.0.1",
    "gulp-flatten": "^0.4.0",
    "gulp-inject": "^5.0.5",
    "gulp-jshint": "^2.1.0",
    "gulp-load-plugins": "^2.0.8",
    "gulp-minify-html": "^1.0.6",
    "gulp-ng-annotate": "^2.1.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-rev": "^12.0.0",
    "gulp-rev-replace": "^0.4.4",
    "gulp-sass": "^6.0.1",
    "gulp-size": "^5.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "gulp-useref": "^5.0.0",
    "http-proxy-middleware": "^3.0.5",
    "jade": "^1.11.0",
    "jshint": "^2.13.6",
    "jshint-stylish": "^2.2.1",
    "karma": "^6.4.4",
    "karma-angular-filesort": "^1.0.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-ng-html2js-preprocessor": "^1.0.0",
    "lodash": "^4.17.21",
    "main-bower-files": "^2.13.3",
    "markdownlint-cli": "^0.47.0",
    "merge-stream": "^2.0.0",
    "require-dir": "^1.2.0",
    "sass": "^1.32.13",
    "typescript": "^5.9.3",
    "uglify-save-license": "^0.4.1",
    "vite": "^7.3.1",
    "wiredep": "^4.0.0",
    "wrench": "^1.5.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@types/mapbox-gl": "^3.4.1",
    "mapbox-gl": "^3.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
